{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"vite\" --names=server,queue,logs,vite --kill-others",
        "dev:vite": "vite",
        "lint": "eslint resources/js --fix",
        "format": "prettier --write 'resources/js/**/*.{vue,js}'"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.0",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-react": "^6.0.3",
        "concurrently": "^9.0.1",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.10.0",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0",
        "vue-eslint-parser": "^10.4.1"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.6.1",
        "@vitejs/plugin-vue": "^6.0.7",
        "alpinejs": "^3.15.12",
        "chart.js": "^4.5.1",
        "ponytail": "^1.0.57",
        "simple-mind-map": "^0.14.0-fix.3",
        "vue": "^3.5.39",
